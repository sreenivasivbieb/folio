{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.2.0",
  "identifier": "dev.folio.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" }
  },
  "app": {
    "windows": [
      { "title": "Folio", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 640 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-first voice labeling & knowledge organization",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
